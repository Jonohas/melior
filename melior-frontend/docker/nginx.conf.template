# Rendered by the nginx image's envsubst step; only the variables in NGINX_ENVSUBST_FILTER are
# substituted, so nginx's own $variables stay intact.

# WebSocket upgrade handling: "upgrade" for upgrade requests, "close" otherwise.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The scheme the browser used: the edge proxy's, when there is one, otherwise nginx's own.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Rooms are pinned to one backend instance by a consistent hash of the room, so everyone in a room reaches
# the instance that holds it. The server list comes from MELIOR_SERVER_URLS (see entrypoint.d).
upstream melior_ws {
    hash $arg_channel_id consistent;
${MELIOR_UPSTREAM_SERVERS}}

# Everything else is stateless on the backend: plain round robin.
upstream melior_http {
${MELIOR_UPSTREAM_SERVERS}}

server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               image/svg+xml;

    # Long cache for hashed assets emitted by Vite.
    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Signalling WebSocket, hashed on channel_id (upstream melior_ws). The Host header is forwarded unchanged:
    # the backend builds the Keycloak redirect_uri from its FRONTEND_URL and checks it against what the
    # browser used.
    location = /ws {
        proxy_pass ${MELIOR_UPSTREAM_SCHEME}://melior_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_buffering    off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # API and the OIDC flow (/login, /signin, /signout), same backend and same list as the Vite dev
    # proxy. Regex locations win over the prefix `location /` below, so the SPA fallback never
    # swallows these paths.
    location ~ ^/(api|login|signin|signout)(/|$) {
        proxy_pass ${MELIOR_UPSTREAM_SCHEME}://melior_http;
        proxy_http_version 1.1;
        # Passive failover, for these stateless paths only: a WebSocket must stay on the instance that owns
        # its room, so /ws deliberately has no proxy_next_upstream. Non-idempotent requests are not retried.
        proxy_next_upstream error timeout http_502 http_503;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Connection        "";
        proxy_buffering    off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # SPA fallback for client-side routes (/rooms/<channel>).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
