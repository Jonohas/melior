# Run ./init-env.sh to create docker/.env with generated secrets. Values below
# marked "secret" are placeholders; compose refuses to start while they are
# unset. Everything else shows the built-in default.
# Avoid '$' in passwords (compose treats it as interpolation).

# Postgres: the application database (room registry) and Keycloak's database.
# The Keycloak role/database are created only when the postgres volume is first
# initialised; changing these passwords later needs `docker compose down -v`.
POSTGRES_DB=melior
POSTGRES_USER=melior
# secret
POSTGRES_PASSWORD=change-me-run-init-env.sh
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
# secret
KEYCLOAK_DB_PASSWORD=change-me-run-init-env.sh

# Keycloak admin console (http://localhost:8300). The realm "melior" is imported
# from keycloak/melior-realm.json. The test users alice/bob/carol/guest
# (password = username) come from the file named by KEYCLOAK_USERS_FILE; set it
# to ./keycloak/no-users.json for any deployment.
KEYCLOAK_PORT=8300
# The URL browsers use for Keycloak, if it is not http://localhost:<KEYCLOAK_PORT>.
#KEYCLOAK_PUBLIC_URL=https://id.example.org
KEYCLOAK_ADMIN_USERNAME=admin
# secret
KEYCLOAK_ADMIN_PASSWORD=change-me-run-init-env.sh
KEYCLOAK_USERS_FILE=./keycloak/melior-users-0.json

# coturn uses time-limited credentials (TURN REST API): the SFU derives them
# from this shared secret and hands them to browsers.
# secret
TURN_SECRET=change-me-run-init-env.sh
TURN_REALM=localhost
# Address clients use to reach the relay. 127.0.0.1 works for single-machine
# testing; use the host's LAN/public IP otherwise. coturn also accepts
# "public/private" to map a NAT address.
TURN_EXTERNAL_IP=127.0.0.1
# Interface for the published coturn ports. Use 0.0.0.0 to serve other machines.
COTURN_BIND=127.0.0.1
# Folder with cert.pem and privkey.pem, only needed if TLS is enabled in turnserver.conf
COTURN_CERT_DIR=./certs

# RustFS holds the images sent in chat (S3 API on 127.0.0.1:9000, console on
# 127.0.0.1:9001). The SFU signs in with the same key pair.
RUSTFS_ACCESS_KEY=melior
# secret
RUSTFS_SECRET_KEY=change-me-run-init-env.sh

# GIF search (KLIPY). The key reaches signed-in browsers, which search KLIPY
# directly as KLIPY requires. Empty turns GIFs off.
KLIPY_APP_KEY=

# Application services (profile "app")
MELIOR_BIND=0.0.0.0:5000
MELIOR_TURN_URLS=turn:127.0.0.1:3478?transport=udp
MELIOR_TURN_TTL_SECONDS=3600
# The origin browsers use for the app. Must match a redirect URI of the "melior"
# client in Keycloak (keycloak/melior-realm.json lists http(s)://localhost:3000).
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
IDP_ISSUER=http://localhost:8300/realms/melior
IDP_CLIENT_ID=melior
# Empty means the server default: warnings, plus info for Melior's own crates.
RUST_LOG=
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
MELIOR_INSTANCE_ID=melior-1
SESSION_RECHECK_SECONDS=15
# Where the frontend container publishes, and the comma-separated SFU instances
# its nginx spreads rooms over. With `--profile scale` list both:
#   MELIOR_SERVER_URLS=http://host.docker.internal:5000,http://host.docker.internal:5001
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
MELIOR_SERVER_URLS=http://host.docker.internal:5000

# docker-compose.prod.yaml only (required there, ignored otherwise)
#KEYCLOAK_PUBLIC_URL=https://id.example.org
